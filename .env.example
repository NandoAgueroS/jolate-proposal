# JOLATE 2026 — Variables de entorno
# Copiar a .env y editar. Nunca commitear credenciales reales.
# Estas variables las lee docker-compose.yml.

# ── SMTP ──────────────────────────────────────────────────────────────
# Para desarrollo local: MailHog captura los correos (web UI en http://localhost:8025).
# Para staging/producción, apuntar SMTP_HOST al relay real.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
SMTP_FROM_EMAIL=comite@example.local
SMTP_FROM_NAME=Comité Organizador
SMTP_COMMITTEE_EMAILS=comite@example.local

# ── MySQL ──────────────────────────────────────────────────────────────
# Deben coincidir con el servicio db de docker-compose y docker/database/init.sql.
# DB_ROOT_PASSWORD solo lo usa el contenedor MySQL (MYSQL_ROOT_PASSWORD).
DB_HOST=db
DB_NAME=devulp
DB_USER=example
DB_PASS=example
DB_ROOT_PASSWORD=example
