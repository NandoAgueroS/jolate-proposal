# JOLATE 2026 — Environment variables
# Copy to .env and adjust. Never commit real credentials.
# These variables are read by docker-compose.yml.

# ── SMTP ──────────────────────────────────────────────────────────────
# Default for local dev: MailHog (captured mail, web UI at http://localhost:8025).
# For staging/production, point SMTP_HOST to your real relay.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
SMTP_FROM_EMAIL=comite@example.local
SMTP_FROM_NAME=Comité Organizador
SMTP_COMMITTEE_EMAILS=comite@example.local

WORKER_TOKEN=change-me
SITE_URL=http://localhost:8080

# ── MariaDB ───────────────────────────────────────────────────────────
# Must match the docker-compose db service and docker/database/init.sql.
# DB_ROOT_PASSWORD is used by MariaDB only (MARIADB_ROOT_PASSWORD).
DB_HOST=db
DB_NAME=jolate
DB_USER=example
DB_PASS=example
DB_ROOT_PASSWORD=example
