# Make the repo work when dropped as-is into any Apache www folder.
# The frontend SPA lives in frontend/, the PHP backend in backend/.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Frontend forms reference the backend scripts by their frontend-relative
    # name ("procesar-envio.php"). Map every variant to the real script in backend/.
    RewriteRule ^procesar-envio\.php$        backend/procesar-envio.php [L]
    RewriteRule ^frontend/procesar-envio\.php$ backend/procesar-envio.php [L]
    RewriteRule ^registrations\.php$         backend/registrations.php [L]
    RewriteRule ^frontend/registrations\.php$ backend/registrations.php [L]
    RewriteRule ^certificado\.php$           backend/certificado.php [L]
    RewriteRule ^frontend/certificado\.php$  backend/certificado.php [L]

    # Admin dashboard routes (mapped BEFORE the catch-all below).
    RewriteRule ^admin/?$              frontend/admin.html              [L]
    RewriteRule ^admin/auth\.php$      backend/auth.php                 [L]
    RewriteRule ^admin/list\.php$      backend/admin/list.php           [L]
    RewriteRule ^admin/detail\.php$    backend/admin/detail.php         [L]
    RewriteRule ^admin/download\.php$  backend/admin/download_pdf.php   [L]
    RewriteRule ^admin/export\.php$    backend/admin/export_csv.php     [L]
    RewriteRule ^admin/retry-emails\.php$ backend/admin/retry-emails.php [L]

    # Expose uploaded PDFs at /uploads/ while they live in backend/uploads/.
    RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]

    # Everything not under backend/ or frontend/ is served from frontend/
    # (site root and all its relative assets resolve to the SPA folder).
    RewriteCond %{REQUEST_URI} !/backend/
    RewriteCond %{REQUEST_URI} !/frontend/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteRule ^(.*)$ frontend/$1 [L]
</IfModule>
